<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web.CheckBox" owl="1">
    <div class="o-checkbox form-check o_workspace_checkbox" t-att-class="props.className" t-on-click="onClick" t-ref="root">
        <input
            t-att-id="props.id or id"
            type="checkbox"
            class="form-check-input o_workspace_checkbox_input"
            t-att-disabled="props.disabled"
            t-att-checked="props.value"
            t-att-name="props.name"
            t-on-change="onChange"
        />
        <label t-att-for="props.id or id" class="form-check-label o_workspace_checkbox_label">
            <span class="o_workspace_checkbox_mark" aria-hidden="true"/>
            <span class="o_workspace_checkbox_text"><t t-slot="default"/></span>
        </label>
    </div>
</t>

</templates>
