<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.StatusBarField" owl="1">
        <div class="o_workspace_workflow">
            <div role="radiogroup" class="o_statusbar_status o_workspace_workflow_steps" aria-label="Statusbar">
                <t t-set="items" t-value="computeItems()" />
                <t t-set="selectedIndex" t-value="items.unfolded.findIndex((item) => item.isSelected)"/>

                <t t-if="items.folded.length">
                    <button type="button" class="btn dropdown-toggle o_workspace_workflow_more" t-att-class="{ 'o_arrow_button': !env.isSmall, 'btn-primary': env.isSmall }">
                        <Dropdown toggler="'parent'">
                            <t t-foreach="items.folded" t-as="item" t-key="item.id">
                                <DropdownItem class="getDropdownItemClassNames(item)" onSelected="() => this.selectItem(item)">
                                    <t t-esc="item.name" />
                                </DropdownItem>
                            </t>
                        </Dropdown>
                        <t t-if="env.isSmall" t-esc="currentName"/>
                        <t t-else="">More</t>
                    </button>
                </t>

                <t t-foreach="items.unfolded" t-as="item" t-key="item.id">
                    <button
                        type="button"
                        class="btn o_arrow_button o_workspace_workflow_step"
                        t-att-class="{
                            o_arrow_button_current: item.isSelected,
                            o_workspace_workflow_current: item.isSelected,
                            o_workspace_workflow_complete: selectedIndex gt item_index,
                            o_workspace_workflow_upcoming: selectedIndex lt item_index,
                            disabled: item.isSelected or isDisabled,
                        }"
                        role="radio"
                        t-att-aria-checked="item.isSelected ? 'true' : 'false'"
                        t-att-aria-current="item.isSelected ? 'step' : undefined"
                        t-att-disabled="item.isSelected or isDisabled"
                        t-att-data-value="item.id"
                        t-on-click="() => this.selectItem(item)"
                    >
                        <span class="o_workspace_workflow_marker">
                            <i t-if="selectedIndex gt item_index" class="fa fa-check" aria-hidden="true"/>
                            <t t-else="" t-esc="item_index + 1"/>
                        </span>
                        <span class="o_workspace_workflow_label" t-esc="item.name"/>
                    </button>
                </t>
            </div>
        </div>
    </t>

</templates>
