<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_product_attributes" model="ir.actions.act_window">
    <field name="name">Attributes</field>
    <field name="res_model">product.attribute</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

  <record id="action_products" model="ir.actions.act_window">
    <field name="name">Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{'search_default_filter_to_sell': 0}</field>
  </record>

  <menuitem id="menu_products_root" name="Products" sequence="25" groups="base.group_user"/>
  <menuitem id="menu_products" name="Products" parent="menu_products_root" action="action_products" sequence="10"/>
  <menuitem id="menu_product_attributes" name="Attributes" parent="menu_products_root" action="action_product_attributes" sequence="15" groups="product.group_product_variant"/>
  <menuitem id="menu_product_categories" name="Categories" parent="menu_products_root" action="product.product_category_action_form" sequence="20" groups="product.group_product_variant"/>
  <menuitem id="menu_product_pricelists" name="Pricelists" parent="menu_products_root" action="product.product_pricelist_action2" sequence="30" groups="product.group_product_pricelist"/>
  <menuitem id="menu_product_uom" name="Units of Measure" parent="menu_products_root" action="uom.product_uom_form_action" sequence="40" groups="uom.group_uom"/>
</odoo>
