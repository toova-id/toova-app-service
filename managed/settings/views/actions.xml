<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_settings" model="ir.actions.client">
    <field name="name">Pengaturan</field>
    <field name="tag">managed.settings</field>
    <field name="target">current</field>
  </record>

  <record id="action_company_profile" model="ir.actions.act_window">
    <field name="name">Profil Perusahaan</field>
    <field name="res_model">managed.settings.company</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('company_id', '=', user.company_id.id)]</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="action_users" model="ir.actions.act_window">
    <field name="name">Pengguna</field>
    <field name="res_model">managed.settings.user</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('user_id.company_ids', 'in', [user.company_id.id])]</field>
    <field name="context">{}</field>
  </record>

  <record id="action_roles" model="ir.actions.act_window">
    <field name="name">Role &amp; Akses</field>
    <field name="res_model">managed.settings.role</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

  <menuitem id="menu_settings_root" name="Pengaturan" action="action_settings" sequence="100" groups="base.group_user"/>
  <menuitem id="menu_company_profile" name="Profil Perusahaan" parent="menu_settings_root" action="action_company_profile" sequence="10" groups="group_settings_company_read"/>
  <menuitem id="menu_users" name="Pengguna" parent="menu_settings_root" action="action_users" sequence="20" groups="group_settings_users_read"/>
  <menuitem id="menu_roles" name="Role &amp; Akses" parent="menu_settings_root" action="action_roles" sequence="30" groups="group_settings_roles_read"/>
</odoo>
