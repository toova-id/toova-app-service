<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_customer_invoices_read" model="res.groups">
    <field name="name">Finance / Customer Invoices / Read</field>
    <field name="category_id" ref="settings.module_category_managed_permissions"/>
  </record>
  <record id="group_customer_invoices_write" model="res.groups">
    <field name="name">Finance / Customer Invoices / Write</field>
    <field name="category_id" ref="settings.module_category_managed_permissions"/>
    <field name="implied_ids" eval="[(4, ref('group_customer_invoices_read')), (4, ref('account.group_account_invoice'))]"/>
  </record>
  <record id="group_payments_read" model="res.groups">
    <field name="name">Finance / Payments / Read</field>
    <field name="category_id" ref="settings.module_category_managed_permissions"/>
  </record>
  <record id="group_payments_write" model="res.groups">
    <field name="name">Finance / Payments / Write</field>
    <field name="category_id" ref="settings.module_category_managed_permissions"/>
    <field name="implied_ids" eval="[(4, ref('group_payments_read')), (4, ref('account.group_account_invoice'))]"/>
  </record>
</odoo>
