<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <function model="uom.uom" name="write">
    <value eval="[ref('uom.product_uom_unit')]"/>
    <value eval="{'rounding': 1}"/>
  </function>
  <function model="uom.uom" name="write">
    <value eval="[ref('uom.product_uom_kgm'), ref('uom.product_uom_litre'), ref('uom.product_uom_meter')]"/>
    <value eval="{'rounding': 0.001}"/>
  </function>
  <record id="uom_milliliter" model="uom.uom">
    <field name="name">ml</field>
    <field name="category_id" ref="uom.product_uom_categ_vol"/>
    <field name="factor">1000</field>
    <field name="uom_type">smaller</field>
    <field name="rounding">1</field>
  </record>
</odoo>
