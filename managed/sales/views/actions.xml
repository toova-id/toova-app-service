<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_quotations" model="ir.actions.act_window">
    <field name="name">Penawaran</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
    <field name="context">{'default_state': 'draft'}</field>
  </record>

  <record id="action_orders" model="ir.actions.act_window">
    <field name="name">Pesanan</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
    <field name="context">{'create': False}</field>
  </record>

  <record id="sale.sale_menu_root" model="ir.ui.menu">
    <field name="name">Sales</field>
    <field name="active" eval="True"/>
    <field name="sequence">30</field>
  </record>
  <menuitem id="menu_quotations" name="Penawaran" parent="sale.sale_menu_root" action="action_quotations" sequence="10" groups="base.group_user"/>
  <menuitem id="menu_orders" name="Pesanan" parent="sale.sale_menu_root" action="action_orders" sequence="20" groups="base.group_user"/>
</odoo>
